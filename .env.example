# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 選填：早報「國際總經」區塊要用，免費申請 https://fred.stlouisfed.org/docs/api/api_key.html
# 沒填就整段不顯示，不影響其他功能
FRED_API_KEY=

# 推播管道：兩個都填也可以，config.yaml 的 notify.*_enabled 控制哪個生效
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx
TELEGRAM_CHAT_ID=123456789

# 本地測試用：設 1 走假資料，不呼叫任何外部 API
DRY_RUN=1
